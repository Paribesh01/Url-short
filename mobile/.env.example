# Base URL of the Flask API.
#
# - iOS simulator: http://localhost:5000 works as-is.
# - Android emulator: use http://10.0.2.2:5000 (the emulator's alias for
#   the host machine's localhost).
# - Physical device (Expo Go or a dev build): use your computer's LAN IP,
#   e.g. http://192.168.1.23:5000 — localhost on the phone means the phone.
EXPO_PUBLIC_API_URL=http://localhost:5000
