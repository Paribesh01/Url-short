# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/urlshort
DATABASE_URL=postgresql://user:password@localhost:5432/urlshort

# Redis connection string, used to cache short_code -> original_url lookups
REDIS_URL=redis://localhost:6379/0

# Base URL used when composing the full short link returned to clients
BASE_URL=http://localhost:5000

# Flask secret key — also signs the JWTs issued by /api/auth/login and
# /api/auth/register, so keep this real and secret in production.
SECRET_KEY=change-me-in-production

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
